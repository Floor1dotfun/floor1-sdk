    "/api/v1/tokens/search": {
      "get": {
        "operationId": "searchTokens",
        "summary": "Search tokens",
        "description": "Case-insensitive symbol prefix or name match, ordered by symbol. Rate limited to 30 requests per 10 seconds per caller.",
        "tags": [
          "Market"
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Search text, 1 to 64 characters after trimming.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "required": true
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum results.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search tokens",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControl"
              }
            },
            "content": {
