    "/api/v1/tokens/{id}/candles": {
      "get": {
        "operationId": "getCandles",
        "summary": "Token candles",
        "description": "Columnar OHLCV bars, ascending. Use either since or before, not both.",
        "tags": [
          "Market"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TokenId"
          },
          {
            "name": "interval",
            "in": "query",
            "description": "Bar interval.",
            "schema": {
              "type": "string",
              "enum": [
                "1m",
                "5m",
                "15m",
                "1h",
                "4h"
              ],
              "default": "5m"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum bars; the newest are returned.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10080,
              "default": 500
            }
          },
          {
            "name": "since",
            "in": "query",
            "description": "Only bars starting at or after this Unix millisecond time.",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "before",
            "in": "query",
            "description": "Older bars before this Unix millisecond time.",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "$ref": "#/components/parameters/Version"
          }
        ],
        "responses": {
          "200": {
            "description": "Token candles",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControl"
              },
              "x-floor1-version": {
                "$ref": "#/components/headers/MarketVersion"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CandleSeries"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      },
      "head": {
